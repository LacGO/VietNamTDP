8928788&id=61577863662471&rdid=kyTaJMhNo4xNYsZk# |archive-date=2026-04-21 |access-date=2026-04-21}}</ref><ref>{{Chú thích web |last=Trang thông tin xã Hoàng An - Tỉnh Phú Thọ |date=2026-03-03 |title=Tiểu sử tóm tắt 07 người ứng cử đại biểu Hội đồng nhân dân xã Hoàng An khóa nhiệm kỳ 2026 - 2031 tại Đơn vị bầu cử số 04 (Gồm các thôn: Hóc, Chằm, Chấu, Cầu, Lồ, Vàng) |url=https://web.facebook.com/story.php?story_fbid=122162673302928788&id=61577863662471&rdid=HddaivzlQ18vpmE7# |url-status=live |archive-url=https://web.archive.org/web/20260421090807/https://web.facebook.com/story.php?story_fbid=122162673302928788&id=61577863662471&rdid=HddaivzlQ18vpmE7# |archive-date=2026-04-21 |access-date=2026-04-21}}</ref><ref>{{Chú thích web |last=Trang thông tin xã Hoàng An - Tỉnh Phú Thọ |date=2026-03-03 |title=Tiểu sử tóm tắt 07 người ứng cử đại biểu Hội đồng nhân dân xã Hoàng An khóa nhiệm kỳ 2026 - 2031 tại Đơn vị bầu cử số 05 (Gồm các thôn: Lau, Thượng, Đoàn Kết, Liên Kết, Mới 1) |url=https://web.facebook.com/story.php?story_fbid=122162703056928788&id=61577863662471&rdid=Fez0gvuifYwrS7Ns&_rdc=10&_rdr# |url-status=live |archive-url=https://web.archive.org/web/20260421090807/https://web.facebook.com/story.php?story_fbid=122162703056928788&id=61577863662471&rdid=Fez0gvuifYwrS7Ns&_rdc=10&_rdr# |archive-date=2026-04-21 |access-date=2026-04-21}}</ref><ref>{{Chú thích web |last=Trang thông tin xã Hoàng An - Tỉnh Phú Thọ |date=2026-03-03 |title=Xã Hoàng An trân trọng giới thiệu danh sách những người ứng cử đại biểu Hội đồng nhân dân xã Hoàng An nhiệm kỳ 2026 - 2031 tại đơn vị bầu cử số 06 gồm các thôn: Lá, Gia, Vỏ, Đồng Lực |url=https://www.facebook.com/story.php?story_fbid=122162766182928788&id=61577863662471&rdid=ePm8JP6QDZzlF8BS&_rdc=1&_rdr# |url-status=live |archive-url=https://web.archive.org/web/20260421090807/https://www.facebook.com/story.php?story_fbid=122162766182928788&id=61577863662471&rdid=ePm8JP6QDZzlF8BS&_rdc=1&_rdr# |archive-date=2026-04-21 |access-date=2026-04-21}}</re